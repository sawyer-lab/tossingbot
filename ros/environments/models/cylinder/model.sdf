<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='cylinder'>
    <link name='link'>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00001</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0001</iyy>  <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <visual name='visual'>
        <pose>0 0 0 0 1.5707 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.1</length></cylinder>
        </geometry>
        <material><script><name>Gazebo/Orange</name></script></material>
      </visual>

      <collision name='collision'>
        <pose>0 0 0 0 1.5707 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.1</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu> <mu2>100.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000.0</kp> <kd>1.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      
      <!-- Add velocity damping to reduce rolling -->
      <velocity_decay>
        <linear>0.1</linear>
        <angular>0.1</angular>
      </velocity_decay>
    </link>
  </model>
</sdf>