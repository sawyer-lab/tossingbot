<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='cross'>
    <link name='link'>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0002</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0002</iyy> <iyz>0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>

      <visual name='stem_vis'>
        <geometry>
           <box><size>0.12 0.025 0.025</size></box>
        </geometry>
        <material><script><name>Gazebo/White</name></script></material>
      </visual>
      <collision name='stem_col'>
        <geometry>
           <box><size>0.12 0.025 0.025</size></box>
        </geometry>
        <surface>
           <friction><ode><mu>100.0</mu><mu2>100.0</mu2></ode></friction>
           <contact><ode><kp>100000.0</kp><kd>1.0</kd><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>

      <visual name='crossbar_vis'>
        <pose>0.03 0 0 0 0 0</pose>
        <geometry>
           <box><size>0.025 0.08 0.025</size></box>
        </geometry>
        <material><script><name>Gazebo/White</name></script></material>
      </visual>
      <collision name='crossbar_col'>
        <pose>0.03 0 0 0 0 0</pose>
        <geometry>
           <box><size>0.025 0.08 0.025</size></box>
        </geometry>
        <surface>
           <friction><ode><mu>100.0</mu><mu2>100.0</mu2></ode></friction>
           <contact><ode><kp>100000.0</kp><kd>1.0</kd><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>