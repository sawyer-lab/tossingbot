<robot name="block">
  <link name="block">
    <inertial>
      <origin xyz="0.015 0.015 0.015" /> <!-- Updated to match the new center -->
      <mass value="0.05" />
      <inertia ixx="9e-06" ixy="0.0" ixz="0.0"
               iyy="9e-06" iyz="0.0"
               izz="9e-06" /> <!-- Updated inertia values -->
    </inertial>
    <visual>
      <origin xyz="0.015 0.015 0.015"/> <!-- Updated to match the new center -->
      <geometry>
        <box size="0.03 0.03 0.03" /> <!-- Updated size -->
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.015 0.015 0.015"/> <!-- Updated to match the new center -->
      <geometry>
        <box size="0.03 0.03 0.03" /> <!-- Updated size -->
      </geometry>
    </collision>
  </link>
  <gazebo reference="block">
    <material>Gazebo/Green</material>
    <mu1>1000</mu1>
    <mu2>1000</mu2>
  </gazebo>
</robot>